{
  // 总开关：false = 什么也不改
  "Enabled": true,

  // ---------- 规则一：食品饮料 → 1×1（原 4.0 jeroFoodDrink1x1 的行为） ----------
  "FoodDrink": {
    "Enabled": true,

    // Food / Drink 两个父类
    "ParentIds": [
      "5448e8d04bdc2ddf718b4569",   // Food
      "5448e8d64bdc2dce718b4568"    // Drink
    ],

    // 不改尺寸的物品；默认沿用原 mod 的排除项
    // 5d1b33a686f7742523398398 = item_food_purewater（2×2 纯净水）
    "ExcludeItemIds": [
      "5d1b33a686f7742523398398"
    ],

    // 把 ExtraSizeUp/Down/Left/Right 一并归零
    "ResetExtraSize": true
  },

  // ---------- 规则二：弹匣瘦身（2×2 / 1×3 → 1×2） ----------
  "Magazine": {
    "Enabled": true,

    "ParentId": "5448bc234bdc2d3c308b4569",   // Magazine

    // 命中这些原始尺寸才改
    "From": [
      [2, 2],
      [1, 3]
    ],

    // 目标尺寸
    "To": [1, 2],

    // 把 ExtraSize* 归零
    "ResetExtraSize": true,

    "ExcludeItemIds": []
  },

  // ---------- 规则三：背包压缩（按比例缩放网格+重量） ----------
  // 5448e53e4bdc2d60728b4567 = Backpack
  // GridScale=0.5 + MinGridSize=2（向下取整，最小 2×2）：
  //   6×7 → 3×3，5×7 → 2×3，5×6 → 2×3，4×5 → 2×2，4×4 → 2×2
  // WeightScale=0.5: 2.95kg → 1.48kg，1.10kg → 0.55kg
  "Backpack": {
    "Enabled": true,

    "ParentId": "5448e53e4bdc2d60728b4567",

    "GridScale": 0.5,
    "WeightScale": 0.5,
    "MinGridSize": 2,
    "ResetExtraSize": true,

    "ExcludeItemIds": []
  },

  // ---------- 规则四：弹挂压缩（按比例缩放网格+重量） ----------
  // 5448e5284bdc2dcb718b4567 = Vest（Tactical Rig）
  // GridScale=0.5 + MinGridSize=2（向下取整，最小 2×2）：
  //   4×4 → 2×2，3×4 → 2×2，4×3 → 2×2，2×3 → 2×2
  // WeightScale=0.5: 2.88kg → 1.44kg，1.70kg → 0.85kg
  "Rig": {
    "Enabled": true,

    "ParentId": "5448e5284bdc2dcb718b4567",

    "GridScale": 0.5,
    "WeightScale": 0.5,
    "MinGridSize": 2,
    "ResetExtraSize": true,

    "ExcludeItemIds": []
  },

  // ---------- 规则五：防弹衣压缩（按比例缩放网格+重量） ----------
  // 5448e54d4bdc2dcc718b4568 = Armor（护甲 / 防弹衣）
  // GridScale=0.5 + MinGridSize=2（向下取整，最小 2×2）：
  //   3×3 → 1×1 钳到 2×2；3×4 → 1×2 钳到 2×2；4×3 → 2×1 钳到 2×2；4×4 → 2×2
  //   ★即护甲原始尺寸只有这四种，缩放后全部触到 MinGridSize ⇒ 折叠后统一为 2×2，
  //     不保留尺寸梯度（要梯度须改成固定映射表，本版按「与背包/弹挂同口径」处理）
  // WeightScale=0.5: 11.1kg → 5.55kg，3.5kg → 1.75kg
  "Armor": {
    "Enabled": true,

    "ParentId": "5448e54d4bdc2dcc718b4568",

    "GridScale": 0.5,
    "WeightScale": 0.5,
    "MinGridSize": 2,
    "ResetExtraSize": true,

    "ExcludeItemIds": []
  },

  // 每条规则的汇总行写日志（汇总行含「命中父类 N 件」；
  // 某条规则命中 0 件会额外打一条 Error，便于发现 ParentId 配错）
  "ConsoleLog": true
}
